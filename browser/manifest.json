{
  "manifest_version": 3,
  "name": "Allie 2.1 Live Overlay",
  "version": "11.2.17.0",
  "version_name": "11.2.17",
  "key": "",
  "description": "Lokale Allie-Zughinweise für Chess.com und Lichess.",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "permissions": [
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Allie 2.1 Live Overlay"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chess.com/play/*",
        "https://www.chess.com/play/*",
        "https://www.chess.com/game/*",
        "https://www.chess.com/analysis/*",
        "https://www.chess.com/watch/*",
        "https://www.chess.com/broadcast/*",
        "https://lichess.org/*"
      ],
      "js": [
        "allie21_overlay.user.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
