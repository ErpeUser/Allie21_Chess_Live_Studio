{
  "manifest_version": 3,
  "name": "Allie 2.1 Live Overlay",
  "version": "11.2.19.0",
  "version_name": "11.2.19",
  "key": "",
  "description": "Lokale Allie-Zughinweise mit Worker-Diagnose und lokalen Entwicklungsupdates.",
  "host_permissions": ["http://127.0.0.1/*"],
  "permissions": ["alarms", "storage"],
  "options_page": "options.html",
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Allie: Verbindung und Updates"},
  "content_scripts": [{
    "matches": ["https://chess.com/play/*", "https://www.chess.com/play/*", "https://www.chess.com/game/*", "https://www.chess.com/analysis/*", "https://www.chess.com/watch/*", "https://www.chess.com/broadcast/*", "https://lichess.org/*"],
    "js": ["allie21_overlay.user.js"],
    "run_at": "document_idle"
  }]
}
