#!/bin/sh
# Read-only pre-commit: reject unapproved indexed paths and generated artifacts.
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ "$(git branch --show-current)" != "main" ]; then
  echo 'Allie commits must be created on the canonical main branch.' >&2
  exit 1
fi
exec python source/automation/check_repository_policy.py
