# generated/ contains isolated build/runtime state and an optional separate Git database.
# Only the PINNED and SHA-256-manifested vendored model source is versioned.
/generated/*
!/generated/dependencies/
/generated/dependencies/*
!/generated/dependencies/vendor/
!/generated/dependencies/vendor/**
/generated/dependencies/vendor/**/.cache/
__pycache__/
*.py[cod]
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv*/
pytest-cache-files-*/
config.json
/source/app/browser/allie-build.json
graphify-out/
node_modules/
*.egg-info/
.coverage*
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
*.swp
*.tmp
*.bak
# Legacy output paths must not be committed during migration.
/release/
/.build/
.codex/
.githooks/
